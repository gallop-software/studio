{
  "name": "@gallop.software/studio",
  "version": "2.3.165",
  "description": "Standalone media manager - upload, process, and sync images to CDN",
  "type": "module",
  "bin": {
    "studio": "./bin/studio.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsup",
    "build:client": "vite build",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "media-manager",
    "image-processing",
    "cloudflare-r2",
    "gallop",
    "cdn",
    "cli",
    "studio"
  ],
  "author": "Gallop Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gallop-software/studio.git"
  },
  "homepage": "https://github.com/gallop-software/studio#readme",
  "bugs": {
    "url": "https://github.com/gallop-software/studio/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@emotion/react": "^11.14.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "open": "^10.1.0",
    "puppeteer": "^24.36.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-image-crop": "^11.0.10",
    "sharp": "^0.33.5",
    "ttf2woff2": "^6.0.1"
  },
  "devDependencies": {
    "@emotion/babel-plugin": "^11.13.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  }
}
